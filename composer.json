{
    "name": "in/employee-reports",
    "description": "A WordPress plugin for generating employee reports.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "Your Name",
            "email": "your.email@example.com"
        }
    ],
    "autoload": {
        "psr-4": {
            "InEmployeeReports\\": "source/classes/"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^9.5",
        "squizlabs/php_codesniffer": "^3.7",
        "wp-coding-standards/wpcs": "^2.3"
    },
    "scripts": {
        "test": "phpunit",
        "lint": "phpcs -d memory_limit=256M --standard=WordPress --exclude=WordPress.WhiteSpace.ControlStructureSpacing --ignore=source/assets/,vendor/,node_modules/ source/",
        "lint-fix": "phpcbf -d memory_limit=256M --standard=WordPress --exclude=WordPress.WhiteSpace.ControlStructureSpacing --ignore=source/assets/,vendor/,node_modules/ source/"
    }
}
